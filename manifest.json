{
  "manifest_version": 3,
  "name": "chrome-vimium-c",
  "version": "0.1.0",
  "author": "Burduja Sergiu Blueline",
  "homepage_url": "https://github.com/seriiserii825/chrome-vimium-c",
  "description": "Keyboard-driven browser navigation",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": ["tabs", "sessions", "downloads", "windows", "storage", "cookies", "scripting", "history", "management", "clipboardRead"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["content.js"]
    }
  ]
}
